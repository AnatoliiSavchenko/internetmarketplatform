        self.system_gateway_ip = "178.104.47.55"
        self.crypto = GemashieldCrypto()

    def register_agent(self, agent):
        self.active_agents[agent.agent_id] = agent

    def send_secure_message(self, sender_id, target_id, raw_payload):
        if target_id in self.active_agents:
            target_agent = self.active_agents[target_id]
            
            # Шифрування пакету
            encrypted_payload = self.crypto.encrypt({
                "sender": sender_id,
                "timestamp": time.time(),
                "data": raw_payload
            })
            
            print(f"[Gateway {self.system_gateway_ip}] SECURE ROUTE: {sender_id} -> {target_id} | Encrypted Pkg: {encrypted_payload[:20]}...")
            
            # Передача зашифрованого пакету
            return target_agent.process_incoming(encrypted_payload)
        return f"[Error] Агент {target_id} offline."

