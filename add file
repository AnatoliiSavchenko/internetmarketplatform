import base64
import json
import time

# ==========================================
# 1. МОДУЛЬ ШИФРУВАННЯ (ENCRYPTION MODULE)
# ==========================================
class GemashieldCrypto:
    def __init__(self, secret_key="Gemashield_Architect_Key_2026"):
        self.secret_key = secret_key

    def encrypt(self, payload_dict):
        """Шифрування даних перед відправкою через Event Bus"""
        json_data = json.dumps(payload_dict)
        # Додавання "солі" та кодування
        secured_string = f"{self.secret_key}::{json_data}"
        encoded_bytes = base64.b64encode(secured_string.encode('utf-8'))
        return encoded_bytes.decode('utf-8')

    def decrypt(self, encrypted_string):
        """Розшифрування пакету на стороні Агента-отримувача"""
        decoded_bytes = base64.b64decode(encrypted_string.encode('utf-8'))
        decoded_string = decoded_bytes.decode('utf-8')
        # Зняття "солі"
        if decoded_string.startswith(f"{self.secret_key}::"):
            json_data = decoded_string.split("::", 1)[1]
            return json.loads(json_data)
        return {"error": "Invalid decryption key or corrupted data"}

